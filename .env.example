# GPD Environment Configuration

# Database path (default: .gpd/gpd.db)
GPD_DATABASE_PATH=.gpd/gpd.db

# API server binding
GPD_API_HOST=127.0.0.1
GPD_API_PORT=7337
GPD_APP_VERSION=0.1.0

# Security: Access token (required when GPD_API_HOST is bound to a non-loopback address)
GPD_ACCESS_TOKEN=

# Slack Integration credentials
GPD_SLACK_SIGNING_SECRET=
GPD_SLACK_BOT_TOKEN=

# Telegram Bot Integration
TELEGRAM_BOT_TOKEN=

# LLM & Embedding provider configuration
OPENAI_API_KEY=
GPD_LLM_MODEL=gpt-4o
GPD_EMBEDDING_MODEL=text-embedding-3-small
GPD_CONTEXT_TOKEN_BUDGET=8000
GPD_SESSION_HEARTBEAT_TIMEOUT_SECONDS=120
